{
  "name": "website",
  "author": "Pete O'Shea",
  "license": "ISC",
  "version": "1.0.0",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "format": "prettier --write .",
    "lint": "eslint . --ext ts --ext tsx --ext js",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "start": "next start",
    "test": "vitest run",
    "test-all": "npm run lint && npm run format && npm run type-check && npm run test-coverage",
    "test-coverage": "vitest run --coverage",
    "type-check": "tsc --pretty --noEmit",
    "test-watch": "vitest"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "eslint",
      "prettier --write"
    ],
    "@(*.@(json|md|yml)|.*rc)": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "micromark": "^4.0.3",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.23.0",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5",
    "vite": "^8.3.5",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "@testing-library/dom": "^10.4.2",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@tailwindcss/postcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
